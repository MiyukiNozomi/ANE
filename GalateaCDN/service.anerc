image galatea

flag ip4 10.0.1.3

build : root {
    pkg install -y python node26 npm-node26 vips pkgconf
    npm i -g typescript
    npm i
    npm rebuild sharp
    npm rebuild better-sqlite3
    npm approve-scripts --all
    tsc
    SHARP_FORCE_GLOBAL_LIBVIPS=1 node \
        --max-old-space-size=1400 --single-threaded-gc \
         dist/prebuild.js --force
}

run : azki {
    cd /service/bin && /usr/local/bin/node .
}