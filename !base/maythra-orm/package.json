{
  "name": "maythra-orm",
  "version": "1.0.0",
  "description": "SQLite3 Abstraction layer for TypeScript (Actually intended for usage with sveltekit ;]) ",
  "main": "./lib/index.js",
  "module": "./lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "bin": {
    "maythra": "./lib/maythra-cli.js"
  },
  "scripts": {
    "tsc": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run tsc",
    "test": "maythra"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.ane.jp.net/u/miyuki/git/MaythraORM.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "author": "Miyuki",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://git.ane.jp.net/u/miyuki/projects/MaythraORM"
  },
  "homepage": "https://auth.ane.jp.net",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.5.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  }
}
