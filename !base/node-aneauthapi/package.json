{
  "name": "ane-authapi",
  "version": "1.0.1",
  "description": "ANE Authorization API for NodeJS",
  "main": "./lib/index.js",
  "module": "./lib/index.d.ts",
  "files": [
    "lib/"
  ],
  "scripts": {
    "tsc": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.ane.jp.net/u/miyuki/projects/ANEAuthAPI.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  },
  "author": "Miyuki",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://git.ane.jp.net/u/miyuki/projects/ANEAuthAPI"
  },
  "homepage": "https://auth.ane.jp.net",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.5.5",
    "typescript": "^5.6.2"
  }
}
