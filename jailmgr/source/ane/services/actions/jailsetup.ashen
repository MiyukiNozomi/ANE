import ashen.fs;
import ashen.io;
import ashen.strings;

import stdc.stdlib;

import ane.services.tools;
import ane.services.servicespec;

proc downloadImage() {
    if (fsExists(fsPathJoin(getUserHomeFolder(), ".ANE/images/freebsd-base.tar.xz")))
        return true;

    system("mkdir -p ~/.ANE/images"N);

    if (system("fetch https://download.freebsd.org/ftp/releases/amd64/amd64/15.0-RELEASE/base.txz -o ~/.ANE/images/freebsd-base.tar.xz"N)) {
        printString("Download Failed!\n");
        return false;
    }

    return true;
}

proc buildJail(recipe : JailRecipe, aneRCFileLoc : String) {
    var jaildir = recipe.jailDirectory();
    
    if (fsExists(jaildir)) {
        printStrings(["Wont be creating jail ", recipe.name, " as it is already setup. running tasks instead..\n"]);
        system("service jail start ".concat(recipe.name).toNullTerminatedPointer());
        recipe.runCommand("root", "sysrc aneservice_enable='NO'");
        system("service jail restart ".concat(recipe.name).toNullTerminatedPointer());
    } else {
        if (!downloadImage()) return false;
        
        system("mkdir -p ".concat(jaildir).toNullTerminatedPointer());
        if (system(
            formatStrings(["tar -xf ~/.ANE/images/freebsd-base.tar.xz -C ", jaildir, " --unlink"]).toNullTerminatedPointer()
            )) {
            printString("Extraction failed.\n");
            return false;
        }

        fsWriteText(jaildir.clone().concat("/etc/resolv.conf"), "
# Generated by ANE service tool, using google DNS.

nameserver 8.8.8.8
nameserver 8.8.4.4

nameserver 2001:4860:4860::8888
nameserver 2001:4860:4860::8844
");

        if (fsExists("/etc/localtime")) {
            system(formatStrings(["cp /etc/localtime ",jaildir, "/etc/localtime"]).toNullTerminatedPointer());
        } 

        // TODO maybe do updates? freebsd-update -b /usr/local/jails/containers/classic/ fetch install
        // but 15.0 is already up to date anyway so.. good enough.

        system("mkdir -p /etc/jail.conf.d/"N);
        
        if (!fsExists("/etc/jail.conf")) {
            fsWriteText("/etc/jail.conf", "include \"/etc/jail.conf.d/*.conf\"");
        }

        var builder = createConfig(recipe);

        fsWriteText("/etc/jail.conf.d/".concat(recipe.name).concat(".conf"), builder.toString());

        printString("Successfully created jail, if you need to update anything, run: \n");
        printStrings(["freebsd-update -b ",jaildir, " fetch install\n"]);
        printString("Anyways, starting jail now\n");

        if (system("service jail start ".concat(recipe.name).toNullTerminatedPointer())) {
            printString("Failed to start jail!");
            return false;
        }

        recipe.runCommand("root", "pw useradd azki -d /service/storage -c \"INoNoKa AZKi\" -s /bin/sh", false);
        recipe.runCommand("root", "mkdir -p /service/storage && chown -R azki:azki /service/storage", false);
    }

    recipe.runCommand("root", "rm -rf /service/bin && mkdir -p /service/bin", false);

    var serviceFileLocation = "./";
    if (aneRCFileLoc.contains('/')) {
        serviceFileLocation = aneRCFileLoc.slice(0, aneRCFileLoc.lastIndexOf('/'));
        serviceFileLocation.concat("/*");
    }

    printString("\e[31mNOTE!! Service files will be treated as if they were on ");
    printStrings(["\e[22m", serviceFileLocation, "!!!!\e[0m\n"]);

    if (system(formatStrings(["cp -r ", serviceFileLocation," ", fsPathJoin(jaildir.clone(), "/service/bin")]).toNullTerminatedPointer())) {
        printString("Failed to copy service files!");
        return false;
    }
    
    if (!recipe.tryRunTask("build")) {
        printString("Failed to build container!\n");
        return false;
    }

    var runTaskOrNull = recipe.getTask("run");

    if (runTaskOrNull then runTask) {
        var script = "#!/bin/sh\ncd /service/bin\n";
        for (command in runTask.commands) {
            command.trim();
            if (command.startsWith("@ANE:")) {
                printString("WARNING! line has been ignored! unsupported in run task: ".concat(command).concat("\n"));
                continue;
            }
            script.concat(command).concat("\n");
        }

        fsWriteText(fsPathJoin(jaildir.clone(), "/service/launch.sh"), script);
        recipe.runCommand("root", "chmod u+x /service/launch.sh");

        fsWriteText(fsPathJoin(jaildir.clone(), "/etc/rc.d/aneservice"), getDefaultRCScript(recipe));
        recipe.runCommand("root", "chmod +x /etc/rc.d/aneservice");

        recipe.runCommand("root", "sysrc aneservice_enable=\"YES\"");
        
        printString("Run script and RC script are done, but require manual startup.\n");
    }

    printString("Container has been built!\n");
    return true;
}

proc createConfig(recipe : JailRecipe) {
    var builder = newStringBuilder();
    builder.print(recipe.name);
    builder.print("{ \n");
    builder.prefix = "\t";

    builder.print("
# STARTUP/LOGGING
exec.start = \"/bin/sh /etc/rc\";
exec.stop = \"/bin/sh /etc/rc.shutdown\";
exec.consolelog = \"/var/log/jail_console_${name}.log\";

# PERMISSIONS
allow.raw_sockets;
exec.clean;
mount.devfs;
");

builder.print(formatStrings(["host.hostname = \"ane-", recipe.name, "\"; "]));
builder.print(formatStrings(["path = \"", recipe.jailDirectory(), "\"; "]));

// network
builder.print("

ip4 = inherit;
");
    if (recipe.isFlagTruty("ipv6")) {
        builder.print("ip6 = inherit;\n");
    }

    builder.prefix = "";
    builder.print("}\n");
    return builder;
}

proc getDefaultRCScript(recipe : JailRecipe) {
    return formatStrings(["#!/bin/sh
# PROVIDE: aneservice
# KEYWORD: shutdown

. /etc/rc.subr

name=\"aneservice\"
rcvar=\"aneservice_enable\"

script_path=\"/service/launch.sh\"
logfile=\"/service/logs.txt\"
pidfile=\"/var/run/${name}.pid\"

command=\"/usr/sbin/daemon\"
command_args=\"-u ", 
    if (recipe.isFlagTruty("rootServiceInit"))
        then "root"
        else "azki"
,"-f -P ${pidfile} -t ${name} -o ${logfile} ${script_path} >> ${logfile} 2>&1\"

load_rc_config $name

# Default enable if not set
: ${aneservice_enable:=\"NO\"}

run_rc_command \"$1\"
"]);
}