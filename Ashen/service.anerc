image ashensv

flag ip4 10.0.1.4

build : root {
    pkg install -y python node26 npm-node26
    cd / && npm i -g typescript
    npm i
    npm approve-scripts --all
    npm rebuild better-sqlite3
    npm run build
}

run : azki {
    export PORT=5600
    cd /service/bin && /usr/local/bin/node build/
}