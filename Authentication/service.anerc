image authentication

build : root {
    pkg install -y python311 node24 npm-node24 vips pkgconf sqlite3
    echo "DEVMODE=false >> /service/bin/.env"
    npm i -g typescript
    npm i
    npm approve-builds
    SHARP_FORCE_GLOBAL_LIBVIPS=1 npm build
}

run : azki {
    export DEVMODE=false
    export PORT=4000
    export BODY_SIZE_LIMIT=16M
    export SHARP_FORCE_GLOBAL_LIBVIPS=1
    cd /service/bin && /usr/local/bin/node build/
}
