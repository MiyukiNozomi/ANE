image gitsystem

flag ip4 10.0.1.5

build : root {
    pkg install -y python node26 npm-node26 pkgconf git
    npm i -g typescript
    npm i
    npm approve-scripts --all
    npm rebuild better-sqlite3
    npm run build
}

run : azki {
    export PORT=2000
    export BODY_SIZE_LIMIT=1G
    cd /service/bin && /usr/local/bin/node build/
}