image gitsystem

flag ip4 10.0.1.5

build : root {
    pkg install -y python node24 npm-node24 pkgconf git
    npm approve-scripts --all
    npm i -g typescript
    npm i
    npm approve-builds
    npm build
}

run : azki {
    export PORT=2000
    export BODY_SIZE_LIMIT=1G
    cd /service/bin && /usr/local/bin/node build/
}