image reverse-proxy

flag expose true
flag rootServiceInit true

build : root {
    pkg install -y security/py-certbot python node24 npm-node24 sqlite3
    npm approve-scripts --all
    npm i -g typescript
    npm i
    tsc
    su - azki -c "cd /service/bin && /usr/local/bin/node bin/prebuild.js"

    echo "REVERSEPROXY NOTE: IF YOU HAVENT SETUP THE CERTIFICATE YET, RUN THE setup-cert TASK!!!"
}

setup-cert : root {
    certbot certonly --standalone
}

run : root {
    cd /service/bin/ssl && ./copy-certs.sh
    cd /service/bin && /usr/local/bin/node .
}