image reverse-proxy

flag rootServiceInit true

build : root {
    pkg install -y security/py-certbot node24 npm-node24 sqlite3
    npm i -g typescript
    npm i
    tsc

    certbot certonly --standalone

    cd /service/bin/ssl && ./copy-certs.sh

    su - azki -c 'cd /service/bin && /usr/local/bin/node bin/prebuild.js'
}

run : azki {
    cd /service/bin && /usr/local/bin/node .
}